<?xml version="1.0" encoding="utf-8"?>
<!-- Release: TLS everywhere, system trust anchors only. No user-installed CAs, so a proxy
     certificate added on the phone cannot read WOLF traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
