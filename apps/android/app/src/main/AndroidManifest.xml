<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WebRTC watches for network changes so a stream can move from Wi-Fi to mobile data. Reading
         network state only; no microphone, camera or location permission is asked for. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Showing a notification after a wake-up. Asked for from the Alerts screen, when the owner chooses. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app lock's fingerprint or face unlock, through AndroidX Biometric, which declares USE_BIOMETRIC. It also
         declares USE_FINGERPRINT for Android 8 and older; this app starts at Android 9, where that permission is
         deprecated and unused, so it is removed rather than shipped. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <!-- Keeping a remote desktop stream connected while the owner is briefly in another app, such as the file picker.
         Android cuts background apps' network access; a foreground service, with its notification, is the permitted
         way to keep it. Only while a stream is open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        allowBackup is off and every domain is excluded from extraction: the refresh token blob
        and the device identity must not be copied to a cloud backup or another phone. The Keystore
        keys that decrypt them would not come along anyway, so a restored copy would only be a
        broken sign-in that looks like a working one.

        allowAudioPlaybackCapture is off for the same reason the window is FLAG_SECURE: the app plays another
        machine's sound, and another app holding a screen-capture grant should not be able to record it.
    -->
    <application
        android:name=".WolfApplication"
        android:allowAudioPlaybackCapture="false"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wake-ups. Not exported: only the platform's push delivery reaches it. -->
        <service
            android:name=".remote.StreamForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an open remote desktop session to the owner's own PC connected while another app, such as the file picker, is on screen." />
        </service>

        <service
            android:name=".push.WolfMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Firebase is started by the app from this build's own project settings, or not at all, rather than
             by a provider looking for a google-services.json this repository does not have. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>
</manifest>
