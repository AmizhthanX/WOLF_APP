<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WebRTC watches for network changes so a stream can move from Wi-Fi to mobile data. Reading
         network state only; no microphone, camera or location permission is asked for. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        allowBackup is off and every domain is excluded from extraction: the refresh token blob
        and the device identity must not be copied to a cloud backup or another phone. The Keystore
        keys that decrypt them would not come along anyway, so a restored copy would only be a
        broken sign-in that looks like a working one.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="WOLF"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
