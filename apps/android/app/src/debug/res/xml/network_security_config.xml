<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: cleartext to the emulator's alias for the development machine, so the app
     can reach a local API. Every other host keeps the release rules. Release builds never see
     this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
