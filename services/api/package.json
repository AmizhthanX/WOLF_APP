{
  "name": "@wolf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "db:migrate": "node dist/cli/migrate.js",
    "bootstrap:owner": "node dist/cli/bootstrap-owner.js",
    "test": "tsc -b && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@wolf/auth": "0.1.0",
    "@wolf/protocol": "0.1.0",
    "@wolf/shared-types": "0.1.0",
    "@wolf/telemetry-schema": "0.1.0",
    "@wolf/validation": "0.1.0",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1",
    "@wolf/server-core": "0.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./app": {
      "types": "./dist/http/app.d.ts",
      "default": "./dist/http/app.js"
    },
    "./context": {
      "types": "./dist/http/context.d.ts",
      "default": "./dist/http/context.js"
    },
    "./rate-limit": {
      "types": "./dist/http/rate-limit.d.ts",
      "default": "./dist/http/rate-limit.js"
    }
  }
}
