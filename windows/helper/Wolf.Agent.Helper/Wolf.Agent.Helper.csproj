<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A background service with no window. It is started by the service control manager
         and, in development, from a console. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Wolf.Agent.Helper</RootNamespace>
    <AssemblyName>Wolf.Agent.Helper</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <!-- SMART data is published through WMI. Reading it through the storage IOCTLs directly
         would mean hand-writing the ATA pass-through structures for every bus type. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The IPC framing and the helper contract are shared with the agent, which is the
         only thing that talks to this process. -->
    <ProjectReference Include="..\..\agent\Wolf.Agent.Core\Wolf.Agent.Core.csproj" />
  </ItemGroup>

</Project>
