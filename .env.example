# WOLF local development configuration.
# Copy to .env and fill in real values. NEVER commit .env.

# ---------------------------------------------------------------------------
# Shared (API + realtime)
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Postgres. Create the database first: createdb wolf
DATABASE_URL=postgres://wolf:wolf@localhost:5432/wolf
DATABASE_POOL_MAX=10
# "require" in any deployed environment.
DATABASE_SSL=disable

# Access-token signing secret. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every access token immediately.
WOLF_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
WOLF_TOKEN_ISSUER=https://api.amizhthan.app
WOLF_TOKEN_AUDIENCE=wolf-client

# Browser origins allowed to call the API. Comma separated, no wildcards in production.
WOLF_ALLOWED_ORIGINS=http://localhost:3000

# Reject agent telemetry whose timestamps drift further than this from server time.
WOLF_MAX_CLOCK_DRIFT_SECONDS=300
# A command not delivered within this window expires instead of running late.
WOLF_COMMAND_TTL_SECONDS=120
WOLF_SESSION_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Remote desktop (WebRTC)
# ---------------------------------------------------------------------------
# Both are empty by default. With neither set, remote desktop connects only on the same
# local network, and WOLF says so in the UI rather than letting you discover it by
# timeout. A public STUN server is a third party that learns your address every time a
# stream starts, so WOLF does not opt you into one silently.
#
# Self-hosted coturn provides both, and is the recommended setup:
#   WOLF_STUN_URLS=stun:relay.example.com:3478
#   WOLF_TURN_URLS=turn:relay.example.com:3478?transport=udp
WOLF_STUN_URLS=
WOLF_TURN_URLS=

# Must match coturn's `static-auth-secret`. Required when TURN URLs are set. Credentials
# are derived per request and expire on their own; nothing per-session is stored.
WOLF_TURN_SECRET=
WOLF_TURN_CREDENTIAL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Push wake-ups (docs/architecture/push.md)
# ---------------------------------------------------------------------------
# "none" (the default) sends nothing, and the phone says news shows only while WOLF is open.
# "fcm" sends a content-free wake-up through Firebase Cloud Messaging and needs both values
# below. The credentials file is a service-account key mounted from secret management —
# a path, never the key itself in the environment.
WOLF_PUSH_PROVIDER=none
# WOLF_FCM_PROJECT_ID=your-firebase-project
# WOLF_FCM_CREDENTIALS_FILE=/secrets/fcm-service-account.json

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Owner bootstrap (used once, by scripts/bootstrap-owner)
# ---------------------------------------------------------------------------
# WOLF_OWNER_EMAIL=owner@example.com
# WOLF_OWNER_PASSWORD=a-long-passphrase-at-least-12-characters
# WOLF_OWNER_NAME=Owner

# ---------------------------------------------------------------------------
# Web app (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WOLF_API_URL=http://localhost:8080

# The realtime service, which carries WebRTC signaling. Both services read PORT, so in
# development the realtime service is usually started with PORT=8081.
NEXT_PUBLIC_WOLF_REALTIME_URL=ws://localhost:8081
